        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\n\n\n\n    class Cidade {\n        - nome: String\n        - população: Integer\n        - área: Double\n        + calcularDensidadePopulacional(): Double\n    }\n\n\npackage \&quot;PPA\&quot; {\n    class PlanoPlurianual {\n        - anoInicio: Integer\n        - anoFim: Integer\n        - cidade: Cidade\n        + adicionarDiretriz(Diretriz diretriz): void\n    }\n    \n    class Diretriz {\n        - descricao: String\n        - planoPlurianual: PlanoPlurianual\n        + adicionarTema(Tema tema): void\n    }\n    \n    class Tema {\n        - descricao: String\n        - diretriz: Diretriz\n        + adicionarPrograma(Programa programa): void\n    }\n    \n    class Programa {\n        - descricao: String\n        - tema: Tema\n        + adicionarObjetivo(Objetivo objetivo): void\n    }\n    \n    class Objetivo {\n        - descricao: String\n        - programa: Programa\n        + adicionarIndicador(Indicador indicador): void\n    }\n    \n    class Indicador {\n        - nome: String\n        - formula: String\n        + calcularValor(): Double\n    }\n    \n    class Meta {\n        - valorAlvo: Double\n        - indicador: Indicador\n        + verificarAlcance(): Boolean\n    }\n}\n\nCidade \&quot;1\&quot; --&gt; \&quot;1\&quot; PlanoPlurianual : **possui**\nPlanoPlurianual \&quot;1\&quot; --&gt; \&quot;*\&quot; Diretriz : **possui**\nDiretriz \&quot;1\&quot; --&gt; \&quot;*\&quot; Tema : **possui**\nTema \&quot;1\&quot; --&gt; \&quot;*\&quot; Programa : **possui**\nPrograma \&quot;1\&quot; --&gt; \&quot;*\&quot; Objetivo : **possui**\nObjetivo \&quot;1\&quot; --&gt; \&quot;*\&quot; Indicador : **possui**\nIndicador \&quot;1\&quot; --&gt; \&quot;*\&quot; Meta : **define**\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="e9_S1gZDzmSBZBLx6tFs-1">
