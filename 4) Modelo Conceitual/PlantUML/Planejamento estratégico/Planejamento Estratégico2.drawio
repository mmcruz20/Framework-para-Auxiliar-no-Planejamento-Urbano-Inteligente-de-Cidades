        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\nclass Cidade {\n  -nome: String\n  -população: Int\n  -área: Float\n  -região: String\n  -IDH: Float\n  -PIB: Float\n  +calcularCrescimentoPopulacional(): Float\n  +gerarRelatórioDemográfico(): String\n}\n\n\nclass Desafios {\n  -ID: Int\n  -Descrição: Int\n}\n\n\nclass Stakeholder {\n  -nome: String\n  +tipo: String (Governo, Privado, Comunidade)\n  -nívelEngajamento: String\n  +avaliarParticipação(): Float\n  +definirEstratégiaEngajamento(): Boolean\n}\n\npackage \&quot;Planejamento Estratégico\&quot; {\n\n\nclass PlanoEstratégico {\n  -anoInicial: Int\n  -anoFinal: Int\n  -objetivoGeral: String\n  -visão: String\n  -missão: String\n  -orçamentoTotal: Float\n  +calcularPrazoPlanejamento(): Int\n  +alocarRecursos(): Boolean\n  +gerarRelatórioProgresso(): String\n}\n\n\n\nclass ObjetivoEstratégico {\n  -descrição: String\n  -prioridade: String\n  -responsável: String\n  +calcularProgresso(): Float\n  +definirResponsável(): Boolean\n}\n\nclass Meta {\n  -ID: String\n  -descrição: String\n}\n\nclass AçãoEstratégica {\n  -nome: String\n  -custo: Float\n  -prazo: Int\n  -responsável: String\n  +calcularCustoTotal(): Float\n  +monitorarExecução(): String\n}\n\nclass Indicador {\n  -nome: String\n  -valorMeta: Float\n  -valorAtual: Float\n  -unidadeMedida: String\n  +calcularDesvioMeta(): Float\n  +gerarRelatórioIndicador(): String\n}\n}\n\n\nCidade \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; Desafios : Enfrenta\nCidade \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Stakeholder : Possui\nDesafios \&quot;1..*\&quot; --&gt; \&quot;0..*\&quot; PlanoEstratégico : Orienta\nPlanoEstratégico \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; ObjetivoEstratégico : Contém\nObjetivoEstratégico \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; Meta : Define\nMeta \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; AçãoEstratégica : Estabelece\nAçãoEstratégica \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; Indicador : Monitorado por\nPlanoEstratégico \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Stakeholder : Envolve\n\n@enduml\n\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="Ucwhpf_Dd2xNXfqGBWII-3">
