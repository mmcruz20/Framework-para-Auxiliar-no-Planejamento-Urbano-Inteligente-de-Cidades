        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\nclass Cidade {\n  -nome: String\n  -população: Int\n  -área: Float\n  -região: String\n  -IDH: Float\n  -PIB: Float\n  +calcularCrescimentoPopulacional(): Float\n  +gerarRelatórioDemográfico(): String\n}\n\n\nclass \&quot;Desafios (PE)\&quot; {\n  -ID: Int\n  -Descrição: Int\n}\n\n\nclass Stakeholder {\n  -nome: String\n  +tipo: String (Governo, Privado, Comunidade)\n  -nívelEngajamento: String\n  +avaliarParticipação(): Float\n  +definirEstratégiaEngajamento(): Boolean\n}\n\npackage \&quot;Planejamento Estratégico\&quot; {\n\n\nclass PlanoEstratégico {\n  -anoInicial: Int\n  -anoFinal: Int\n  -objetivoGeral: String\n  -visão: String\n  -missão: String\n  -orçamentoTotal: Float\n  +calcularPrazoPlanejamento(): Int\n  +alocarRecursos(): Boolean\n  +gerarRelatórioProgresso(): String\n}\n\n\n\nclass \&quot;Objetivo (PE)\&quot; {\n  -descrição: String\n  -prioridade: String\n  -responsável: String\n  +calcularProgresso(): Float\n  +definirResponsável(): Boolean\n}\n\nclass \&quot;Meta (PE)\&quot; {\n  -ID: String\n  -descrição: String\n}\n\nclass \&quot;Ação Estratégica (PE)\&quot; {\n  -nome: String\n  -custo: Float\n  -prazo: Int\n  -responsável: String\n  +calcularCustoTotal(): Float\n  +monitorarExecução(): String\n}\n\nclass \&quot;Indicador (PE)\&quot; {\n  -nome: String\n  -valorMeta: Float\n  -valorAtual: Float\n  -unidadeMedida: String\n  +calcularDesvioMeta(): Float\n  +gerarRelatórioIndicador(): String\n}\n}\n\n\nCidade \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; \&quot;Desafios (PE)\&quot; : Enfrenta\nCidade \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Stakeholder : Possui\n\&quot;Desafios (PE)\&quot; \&quot;1..*\&quot; --&gt; \&quot;0..*\&quot; PlanoEstratégico : Orienta\nPlanoEstratégico \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; \&quot;Objetivo (PE)\&quot; : Contém\n\&quot;Objetivo (PE)\&quot; \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; \&quot;Meta (PE)\&quot; : Define\n\&quot;Meta (PE)\&quot; \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; \&quot;Ação Estratégica (PE)\&quot; : Estabelece\n\&quot;Ação Estratégica (PE)\&quot; \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; \&quot;Indicador (PE)\&quot; : Monitorado por\nPlanoEstratégico \&quot;0..*\&quot; --&gt; \&quot;0..*\&quot; Stakeholder : Envolve\n\n\n\n\n\n\n\n\n\n    class Cidade {\n        - nome: String\n        - população: Integer\n        - área: Double\n        + calcularDensidadePopulacional(): Double\n    }\n    \n\npackage \&quot;Plano de Metas\&quot; {\n\n    class \&quot;Eixo Tematico (PM)\&quot; {\n        - nome: String\n        - descricao: String\n    }\n\n    class \&quot;Objetivo (PM)\&quot; {\n        - nome: String\n        - descricao: String\n    }\n\n    class \&quot;Meta (PM)\&quot; {\n        - descricao: String\n    }\n\n    class \&quot;Iniciativa (PM)\&quot; {\n        - nome: String\n        - descricao: String\n    }\n\n    class \&quot;Indicador (PM)\&quot; {\n        - nome: String\n        - formula: String\n        + calcularValor(): Double\n    }\n\n    class Setor {\n        - nome: String\n        - area: Double\n    }\n\n    class Projeto {\n        - nome: String\n        - descricao: String\n        - prazo: Date\n    }\n\n    class Orçamento {\n        - valorTotal: Double\n        - valorGasto: Double\n    }\n\n    class Risco {\n        - descricao: String\n        - probabilidade: Double\n        - impacto: Double\n    }\n\n}\n\nCidade \&quot;1\&quot; -- \&quot;*\&quot; \&quot;Eixo Tematico (PM)\&quot; : **possui**\n\&quot;Eixo Tematico (PM)\&quot; \&quot;1\&quot; -- \&quot;*\&quot; \&quot;Objetivo (PM)\&quot; : **compõe**\n\&quot;Objetivo (PM)\&quot; \&quot;1\&quot; -- \&quot;*\&quot; \&quot;Meta (PM)\&quot; : **define**\n\&quot;Meta (PM)\&quot; \&quot;1\&quot; -- \&quot;*\&quot; \&quot;Iniciativa (PM)\&quot; : **possui**\n\&quot;Iniciativa (PM)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Indicador (PM)\&quot; : **mede**\n\&quot;Iniciativa (PM)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; Setor : **atua em**\n\&quot;Iniciativa (PM)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; Projeto : **compreende**\n\&quot;Iniciativa (PM)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; Orçamento : **consome**\n\&quot;Iniciativa (PM)\&quot; \&quot;*\&quot; -- \&quot;*\&quot; Risco : **está sujeita a**\n\n\n\n\n\n\n\n\n\n\n\n\n    class Cidade {\n        - nome: String\n        - população: Integer\n        - área: Double\n        + calcularDensidadePopulacional(): Double\n    }\n\n\npackage \&quot;PPA\&quot; {\n    class PlanoPlurianual {\n        - anoInicio: Integer\n        - anoFim: Integer\n        - cidade: Cidade\n        + adicionarDiretriz(Diretriz diretriz): void\n    }\n    \n    class \&quot;Diretriz (PPA)\&quot; {\n        - descricao: String\n        - planoPlurianual: PlanoPlurianual\n        + adicionarTema(Tema tema): void\n    }\n    \n    class \&quot;Tema (PPA)\&quot; {\n        - descricao: String\n        - diretriz: Diretriz\n        + adicionarPrograma(Programa programa): void\n    }\n    \n    class \&quot;Programa (PPA)\&quot; {\n        - descricao: String\n        - tema: Tema\n        + adicionarObjetivo(Objetivo objetivo): void\n    }\n    \n    class \&quot;Objetivo (PPA)\&quot; {\n        - descricao: String\n        - programa: Programa\n        + adicionarIndicador(Indicador indicador): void\n    }\n    \n    class \&quot;Indicador (PPA)\&quot; {\n        - nome: String\n        - formula: String\n        + calcularValor(): Double\n    }\n    \n    class \&quot;Meta (PPA)\&quot; {\n        - valorAlvo: Double\n        - indicador: Indicador\n        + verificarAlcance(): Boolean\n    }\n}\n\nCidade \&quot;1\&quot; --&gt; \&quot;1\&quot; PlanoPlurianual : **possui**\nPlanoPlurianual \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Diretriz (PPA)\&quot; : **possui**\n\&quot;Diretriz (PPA)\&quot; \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Tema (PPA)\&quot; : **possui**\n\&quot;Tema (PPA)\&quot; \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Programa (PPA)\&quot; : **possui**\n\&quot;Programa (PPA)\&quot; \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Objetivo (PPA)\&quot; : **possui**\n\&quot;Objetivo (PPA)\&quot; \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Indicador (PPA)\&quot; : **possui**\n\&quot;Indicador (PPA)\&quot; \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Meta (PPA)\&quot; : **define**\n\n\n\n\n\n\n\n\n\n\n\n    class Cidade {\n        - nome: String\n        - população: Integer\n        - área: Double\n        + calcularDensidadePopulacional(): Double\n    }\n\n\npackage \&quot;Plano de Governo\&quot; {\n    class PlanoGoverno {\n        - anoInicio: Integer\n        - anoFim: Integer\n        - cidade: Cidade\n    }\n    \n    class \&quot;Área Temática (PG)\&quot; {\n        - descricao: String\n        - planoGoverno: PlanoGoverno\n    }\n    \n\n}\n\nCidade \&quot;1\&quot; --&gt; \&quot;1\&quot; PlanoGoverno : **possui**\nPlanoGoverno \&quot;1\&quot; --&gt; \&quot;*\&quot; \&quot;Área Temática (PG)\&quot; : **possui**\n\n\n\n\n\n\n\n\n\n\nclass Cidade {\n  +nome: String\n  +população: Int\n  +área: Float\n  +IDH: Float\n  +PIB: Float\n  +gerarRelatórioDesenvolvimento(): String\n}\n\npackage \&quot;PD\&quot; {\n  class PlanoDiretor {\n    +anoVigencia: Int\n    +dataAprovacao: Date\n    +objetivoGeral: String\n    +gerarPlanoDiretor(): String\n    +revisarPlanoDiretor(): Boolean\n    +gerarRelatorioPlanoDiretor(): String\n  }\n\n  class \&quot;Temas (PD)\&quot; {\n    +nomeTema: String\n    +descricao: String\n    +categorizarTema(): Boolean\n    +definirPrioridadeTematica(): Boolean\n    +monitorarTema(): Boolean\n    +gerarRelatorioTema(): String\n  }\n\n  class \&quot;Problematicas (PD)\&quot; {\n    +descricaoProblematica: String\n    +impacto: String\n    +setoresAfetados: String\n    +identificarProblematica(): Boolean\n    +analisarImpacto(): Boolean\n    +gerarRelatorioProblematica(): String\n  }\n\n  class \&quot;Estrategias (PD)\&quot; {\n    +nomeEstrategia: String\n    +descricao: String\n    +objetivoAssociado: String\n    +definirEstrategia(): Boolean\n    +implementacaoEstrategia(): Boolean\n    +monitorarEstrategia(): Boolean\n    +gerarRelatorioEstrategia(): String\n  }\n\n  class Instrumentos {\n    +nomeInstrumento: String\n    +tipoInstrumento: String\n    +finalidade: String\n    +aplicarInstrumento(): Boolean\n    +validarInstrumento(): Boolean\n    +gerarRelatorioInstrumento(): String\n  }\n\n  class FerramentasComplementares {\n    +nomeFerramenta: String\n    +funcao: String\n    +setorAplicacao: String\n    +implementarFerramenta(): Boolean\n    +integrarFerramentas(): Boolean\n    +gerarRelatorioFerramenta(): String\n  }\n}\n\nCidade \&quot;1\&quot; -- \&quot;1\&quot; PlanoDiretor : Segue\nPlanoDiretor \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Temas (PD)\&quot; : Define\n\&quot;Temas (PD)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Problematicas (PD)\&quot; : Envolve\n\&quot;Problematicas (PD)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Estrategias (PD)\&quot; : Soluciona\n\&quot;Estrategias (PD)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; Instrumentos : Utiliza\n\&quot;Estrategias (PD)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; FerramentasComplementares : Apoia\n\n\n\n\n\n\n\n\nclass Cidade {\n  +nome: String\n  +população: Int\n  +área: Float\n  +IDH: Float\n  +PIB: Float\n  +gerarRelatórioDesenvolvimento(): String\n}\n\npackage \&quot;LDO\&quot; {\n  class LeiDiretrizesOrcamentarias {\n    +anoVigencia: Int\n    +dataAprovacao: Date\n    +objetivo: String\n    +gerarLDO(): String\n    +revisarLDO(): Boolean\n    +gerarRelatorioLDO(): String\n  }\n\n  class Receitas {\n    +receitaPrevista: Float\n    +fontesDeReceita: String\n    +calcularReceitaTotal(): Float\n    +monitorarReceita(): Boolean\n    +gerarRelatorioReceitas(): String\n  }\n\n  class Despesas {\n    +despesaPrevista: Float\n    +categoriasDespesas: String\n    +calcularDespesas(): Float\n    +monitorarDespesas(): Boolean\n    +gerarRelatorioDespesas(): String\n  }\n\n  class Investimentos {\n    +investimentoPrevisto: Float\n    +programasInvestimentos: String\n    +definirPrioridadesInvestimento(): Boolean\n    +monitorarInvestimentos(): Boolean\n    +gerarRelatorioInvestimentos(): String\n  }\n\n  class MetasFiscais {\n    +metaSuperavitPrimario: Float\n    +metaResultadoNominal: Float\n    +definirMetasFiscais(): Boolean\n    +monitorarMetasFiscais(): Boolean\n    +gerarRelatorioMetasFiscais(): String\n  }\n\n  class \&quot;Programas (LDO)\&quot; {\n    +nomePrograma: String\n    +descricao: String\n    +orcamentoAlocado: Float\n    +definirPrograma(): Boolean\n    +monitorarPrograma(): Boolean\n    +gerarRelatorioPrograma(): String\n  }\n\n  class \&quot;Projetos (LDO)\&quot; {\n    +nomeProjeto: String\n    +programaAssociado: String\n    +orcamentoPrevisto: Float\n    +definirProjeto(): Boolean\n    +monitorarProjeto(): Boolean\n    +gerarRelatorioProjeto(): String\n  }\n\n  class \&quot;Prioridades (LDO)\&quot; {\n    +nomePrioridade: String\n    +justificativa: String\n    +definirPrioridade(): Boolean\n    +monitorarPrioridade(): Boolean\n    +gerarRelatorioPrioridade(): String\n  }\n\n  class \&quot;Metas (LDO)\&quot; {\n    +nomeMeta: String\n    +prioridadeAssociada: String\n    +prazo: Int\n    +definirMeta(): Boolean\n    +monitorarMeta(): Boolean\n    +gerarRelatorioMeta(): String\n  }\n\n  class \&quot;Indicadores (LDO)\&quot; {\n    +nomeIndicador: String\n    +valorAtual: Float\n    +metaAlvo: Float\n    +prazoCumprimento: Int\n    +definirIndicador(): Boolean\n    +monitorarIndicador(): Boolean\n    +gerarRelatorioIndicador(): String\n  }\n}\n\nCidade \&quot;1\&quot; -- \&quot;1\&quot; LeiDiretrizesOrcamentarias : Segue\nLeiDiretrizesOrcamentarias \&quot;1\&quot; -- \&quot;1\&quot; Receitas : Define\nLeiDiretrizesOrcamentarias \&quot;1\&quot; -- \&quot;1\&quot; Despesas : Coordena\nLeiDiretrizesOrcamentarias \&quot;1\&quot; -- \&quot;1\&quot; Investimentos : Prioriza\nLeiDiretrizesOrcamentarias \&quot;1\&quot; -- \&quot;1\&quot; MetasFiscais : Estabelece\n\nLeiDiretrizesOrcamentarias \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Programas (LDO)\&quot; : Contém\n\&quot;Programas (LDO)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Projetos (LDO)\&quot; : Implementa\n\nLeiDiretrizesOrcamentarias \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Prioridades (LDO)\&quot; : Define\n\&quot;Prioridades (LDO)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Metas (LDO)\&quot; : Alinha\n\&quot;Metas (LDO)\&quot; \&quot;1\&quot; -- \&quot;1\&quot; \&quot;Indicadores (LDO)\&quot; : Monitorado por\n\n\n\n\n\npackage \&quot;Relações\&quot; #lightgreen{\n\n\nclass \&quot;Objetivo\&quot;{}\nclass \&quot;Estratégia\&quot;{}\nclass \&quot;Indicador\&quot;{}\nclass \&quot;Meta\&quot;{}\nclass \&quot;Desafios\&quot;{}\nclass \&quot;Tema\&quot;{}\n}\n\n\n \&quot;Estratégia\&quot; &lt;|-- \&quot;Ação Estratégica (PE)\&quot;\n \&quot;Estratégia\&quot; &lt;|-- \&quot;Diretriz (PPA)\&quot;\n \&quot;Estratégia\&quot; &lt;|-- \&quot;Estrategias (PD)\&quot;\n \&quot;Estratégia\&quot; &lt;|-- \&quot;Iniciativa (PM)\&quot;\n \&quot;Objetivo\&quot; &lt;|-- \&quot;Objetivo (PE)\&quot;\n \&quot;Objetivo\&quot; &lt;|-- \&quot;Objetivo (PPA)\&quot;\n \&quot;Objetivo\&quot; &lt;|-- \&quot;Objetivo (PM)\&quot;\n \&quot;Indicador\&quot; &lt;|-- \&quot;Indicador (PE)\&quot;\n \&quot;Indicador\&quot; &lt;|-- \&quot;Indicador (PPA)\&quot;\n \&quot;Meta\&quot; &lt;|-- \&quot;Meta (PE)\&quot;\n \&quot;Meta\&quot; &lt;|-- \&quot;Meta (PPA)\&quot;\n \&quot;Meta\&quot; &lt;|-- \&quot;Meta (PM)\&quot;\n \&quot;Desafios\&quot; &lt;|-- \&quot;Desafios (PE)\&quot;\n \&quot;Desafios\&quot; &lt;|-- \&quot;Problematicas (PD)\&quot;\n \&quot;Tema\&quot; &lt;|-- \&quot;Tema (PPA)\&quot;\n \&quot;Tema\&quot; &lt;|-- \&quot;Temas (PD)\&quot;\n \&quot;Tema\&quot; &lt;|-- \&quot;Eixo Tematico (PM)\&quot;\n \&quot;Tema\&quot; &lt;|-- \&quot;Área Temática (PG)\&quot;\n